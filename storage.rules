rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir leitura e escrita na pasta comprovantes para usuários autenticados
    match /comprovantes/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regra padrão: negar acesso
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}