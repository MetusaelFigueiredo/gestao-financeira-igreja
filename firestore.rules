rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar se usuário está autenticado
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Função auxiliar para verificar se é administrador
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    // Função auxiliar para verificar se é pastor
    function ehPastor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'pastor';
    }

    // Regras para coleção de usuários
    match /usuarios/{userId} {
      allow read: if isAuthenticated();  // Todos podem ler usuários
      allow create: if isAuthenticated() && request.auth.uid == userId;  // Só pode criar próprio perfil
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||  // Próprio usuário pode atualizar
        ehPastor()  // Pastor pode alterar qualquer perfil
      );
      allow delete: if ehPastor();  // Só pastor pode deletar
    }

    // Regras para coleção de entradas
    match /entradas/{entradaId} {
      allow read: if isAuthenticated();    // Permitir leitura para usuários logados
      allow create: if isAuthenticated();  // Permitir criação para usuários logados
      allow update: if isAuthenticated();  // Permitir atualização para usuários logados
      allow delete: if isAuthenticated();  // Permitir exclusão para usuários logados
    }

    // Regras para coleção de despesas
    match /despesas/{despesaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();  // Permitir exclusão para usuários logados
    }

    // Regras para coleção de membros
    match /membros/{membroId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();  // Qualquer usuário logado pode criar membro
      allow update, delete: if isAdmin();  // Apenas admin pode editar/excluir
    }

    // Regras para coleção de backup
    match /backup/{backupId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 🆕 Regras para coleção de configurações (meta de missões, etc.)
    match /configuracoes/{configId} {
      allow read: if isAuthenticated();  // Todos podem ler configurações
      allow write: if isAuthenticated(); // Todos podem escrever configurações
    }

    // 🎯 Regras para coleção de eventos
    match /eventos/{eventoId} {
      allow read: if isAuthenticated();    // Permitir leitura para usuários logados
      allow create: if isAuthenticated();  // Permitir criação para usuários logados
      allow update: if isAuthenticated();  // Permitir atualização para usuários logados
      allow delete: if isAuthenticated();  // Permitir exclusão para usuários logados
    }

    // Regra padrão: negar tudo que não foi especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}